\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}Scope of Phase 1}{20}{subsection.10.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Monitoring only.}{20}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Manual onboarding.}{20}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No storage pooling.}{20}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No service management and no orderly shutdown.}{20}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{One run per machine, by design.}{20}{section*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Small scale, one local network.}{20}{section*.25}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}Availability and fault tolerance}{20}{subsection.10.2}\protected@file@percent }
\newlabel{sec:lim-availability}{{10.2}{20}{Availability and fault tolerance}{subsection.10.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The head is a single point of failure.}{20}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The head's address must be fixed and numeric.}{20}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Workers are slow to notice a head machine that disappears.}{21}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The head never closes a silent connection.}{21}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The node table never forgets.}{21}{section*.30}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Duplicate identities are not detected.}{21}{section*.31}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Failure detection is timeout-only and binary.}{21}{section*.32}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.3}Security}{21}{subsection.10.3}\protected@file@percent }
\newlabel{sec:lim-security}{{10.3}{21}{Security}{subsection.10.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Machine identity is self-declared.}{21}{section*.33}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Head and worker certificates are interchangeable.}{22}{section*.34}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No revocation and no expiry.}{22}{section*.35}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The CA key is online and unprotected beyond file permissions.}{22}{section*.36}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Re-running init overwrites an identity without warning.}{22}{section*.37}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The listener has no limits.}{22}{section*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Reported figures are trusted as given.}{23}{section*.39}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Local socket permissions are implicit.}{23}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Not audited.}{23}{section*.41}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.4}Protocol evolution}{23}{subsection.10.4}\protected@file@percent }
\newlabel{sec:lim-protocol}{{10.4}{23}{Protocol evolution}{subsection.10.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Upgrades must be done all at once.}{23}{section*.42}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{``Additive'' changes are compatible in one direction only.}{23}{section*.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The channel is one-way today.}{23}{section*.44}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.5}Accuracy of the resource figures}{23}{subsection.10.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The first sample after each connection is wrong.}{23}{section*.45}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{One CPU percentage is not comparable between machines.}{24}{section*.46}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Disk figure.}{24}{section*.47}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Timestamps.}{24}{section*.48}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Linux only.}{24}{section*.49}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.6}Operability}{24}{subsection.10.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Logs are not where people look.}{24}{section*.50}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Misconfiguration does not fail fast.}{24}{section*.51}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{status works only on the head.}{24}{section*.52}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Configuration values are not range-checked.}{24}{section*.53}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The head reads its certificates once.}{24}{section*.54}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The binary is not static.}{25}{section*.55}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No health or metrics interface.}{25}{section*.56}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.7}Testing}{25}{subsection.10.7}\protected@file@percent }
\newlabel{sec:lim-testing}{{10.7}{25}{Testing}{subsection.10.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Fixed ports.}{25}{section*.57}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Untested paths.}{25}{section*.58}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Timing-dependent scripts.}{25}{section*.59}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No continuous integration.}{25}{section*.60}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}Known defects}{25}{section.11}\protected@file@percent }
\newlabel{sec:defects}{{11}{25}{Known defects}{section.11}{}}
\@writefile{toc}{\contentsline {paragraph}{D1. Disk space is reported as zero with a relative data directory.}{25}{section*.61}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D2. A second agent on the same data directory breaks status for the first.}{26}{section*.62}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D3. Agent logs drop the cause of errors.}{26}{section*.63}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D4. A long data-directory path silently disables status.}{26}{section*.64}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D5. A failed accept stops the head.}{27}{section*.65}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D6. A heartbeat interval of zero panics.}{27}{section*.66}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{D7. Key-file permissions are not enforced when a file already exists.}{27}{section*.67}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {12}Roadmap}{27}{section.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {12.1}Phase 2: job submission and scheduling}{27}{subsection.12.1}\protected@file@percent }
