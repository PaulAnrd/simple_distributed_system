\@writefile{toc}{\contentsline {paragraph}{Building the binary.}{16}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. Copy the source to the build machine.}{16}{section*.10}\protected@file@percent }
