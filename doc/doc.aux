\@writefile{toc}{\contentsline {paragraph}{3. Build the release binary.}{17}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Copy the binary to every other machine.}{17}{section*.13}\protected@file@percent }
